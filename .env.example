# Copy to .env (untracked) and fill in. scripts/setup-drs.sh writes it for you.

# SignCollect server the services upload to (shared/server_config.py).
SIGNCOLLECT_URL=https://signcollect.nl

# Token for videoFix/api.php (services/crop_fix.py). Same value as
# VIDEOFIX_TOKEN in the server's <webroot>/.env. Never commit it.
VIDEOFIX_TOKEN=

# DB credentials, read by services/qrConvert.py and tools/check_studiofiles.py.
DB_HOST=signlab-db
DB_USER=user
DB_PASSWORD=
DB_NAME=admin_gebarenoverleg
